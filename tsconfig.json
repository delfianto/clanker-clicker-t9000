{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "lib": ["ES2022", "DOM"],
    "baseUrl": "src",
    "paths": {
      "@types/*": ["types/*"]
    },
    "noEmit": true
  },
  "include": ["src/**/*", "scripts/**/*"],
  "exclude": ["build", "node_modules"]
}
