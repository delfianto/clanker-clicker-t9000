{
  "name": "clanker-clicker-t9000",
  "version": "1.0.0",
  "private": true,
  "description": "Clean shortlink bypasser — MV3 browser extension",
  "type": "module",
  "scripts": {
    "build": "vp build",
    "build:firefox": "BROWSER=firefox vp build",
    "dev": "vp build --watch",
    "dev:firefox": "BROWSER=firefox vp build --watch",
    "check": "vp check && tsc -p tsconfig.json",
    "lint": "vp lint src/",
    "fmt": "vp fmt src/",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "debug": "bun run scripts/debug-bypass.ts"
  },
  "dependencies": {
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "@types/chrome": "^0.3.7",
    "@types/webextension-polyfill": "^0.12.6",
    "happy-dom": "^21.0.4",
    "playwright": "^1.65.0",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.1",
    "vite-plugin-web-extension": "^4.5.1",
    "vite-plus": "1.5.1"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.4",
      "onFail": "download"
    }
  },
  "trustedDependencies": [
    "spawn-sync"
  ]
}
